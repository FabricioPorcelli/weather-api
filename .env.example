# Copiar este archivo a .env y completar con los valores reales.
# El archivo .env NUNCA se commitea (está en .gitignore).

WEATHER_API_KEY=tu_api_key_aqui
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=43200
FORECAST_CACHE_TTL_SECONDS=3600
RATE_LIMIT=10/minute

# Orígenes permitidos para consumir la API desde un navegador (opcional).
# Vacío = CORS desactivado. Separar múltiples orígenes con coma.
# CORS_ORIGINS=http://localhost:5500,https://tu-app.example.com
